{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/choice/**",
              "components/controls/**",
              "components/display/**",
              "components/files/**",
              "components/instrument/**",
              "components/layout/**",
              "components/list/**",
              "components/navigation/**",
              "components/panel/**",
              "components/property/**",
              "components/text/**",
              "components/vector/**",
              "ui_kits/studio-workspace/**",
              "ui_kits/studio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chivo|Chivo Mono))/i]",
        "message": "Font not provided by the design system. Available: Chivo, Chivo Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|live|ok|warn|fault)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'live' | 'ok' | 'warn' | 'fault'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:context|floating|key|ref|className|style|children)$/]",
        "message": "<BrandChip> doesn't accept that prop. Declared props: context, floating."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|disabled|danger|ghost|size|title|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, active, disabled, danger, ghost, size, title, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|default|large)$/]",
        "message": "<Button> size must be one of 'small' | 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, value, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Collapsible'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|defaultOpen|badge|key|ref|className|style|children)$/]",
        "message": "<Collapsible> doesn't accept that prop. Declared props: title, children, defaultOpen, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|key|ref|className|style|children)$/]",
        "message": "<ColorField> doesn't accept that prop. Declared props: label, value, onChange."
