{
  "name": "artinos-ui",
  "version": "1.0.0",
  "description": "ARTINOS UI — a precision-instrument React control system: 59 kit components (sliders to a dockable workspace and a node editor) with 9 themes and twelve type systems. TypeScript source, no build step.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./artinos.css": "./src/artinos.css",
    "./graph/gpu": "./src/graph/gpu.ts",
    "./rig/TransformGizmo": "./src/rig/TransformGizmo.ts",
    "./graph/LiveGraphView": "./src/graph/LiveGraphView.tsx",
    "./graph/NodePreview": "./src/graph/NodePreview.tsx",
    "./src/*": "./src/*",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "docs",
    "skill",
    "tools",
    "artinos.mjs",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tools/*.test.mjs\""
  },
  "bin": {
    "artinos": "./artinos.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "three": ">=0.185"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
